{
  "name": "mnemocard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "npm --workspace=@mnemocard/web run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "seed:firestore": "node scripts/seed-firestore.mjs"
  },
  "devDependencies": {
    "turbo": "^2.11.13",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
