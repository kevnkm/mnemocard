# Firebase web app config (Firebase console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# reCAPTCHA Enterprise site key registered with App Check. Without it, App Check is off.
VITE_FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=
# Development builds only: `true` prints a debug token to register in the console.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=true
